# Bu dosyayi .env olarak kopyalayin. .env Git'e eklenmez.
MACERA_IMAGE_TAG=2.8.1
MACERA_BIND_ADDRESS=127.0.0.1
MACERA_HTTP_PORT=8080

# Sirketin mevcut MySQL/MariaDB sunucusu icin gercek host adini yazin.
# MySQL ayni fiziksel sunucuda yalnizca localhost dinliyorsa Emre ag ayarini
# yapmali; container icinde 127.0.0.1 uygulama container'inin kendisidir.
MACERA_DB_HOST=host.docker.internal
MACERA_DB_PORT=3306
MACERA_DB_NAME=macera_akademi
MACERA_DB_USER=macera_user
MACERA_DB_PASSWORD=BURAYA_GUCLU_PAROLA_YAZIN
MACERA_DB_CHARSET=utf8mb4

MACERA_ALLOWED_ORIGINS=https://maceraakademi.com.tr,https://www.maceraakademi.com.tr,https://appassets.androidplatform.net,null
MACERA_TOKEN_TTL_DAYS=90
MACERA_DEBUG=false

# Yalniz "bundled-db" profiliyle acilan istege bagli MySQL container'i icindir.
MACERA_DB_ROOT_PASSWORD=BURAYA_FARKLI_BIR_ROOT_PAROLASI_YAZIN
